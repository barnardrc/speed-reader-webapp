APP_ENV=development
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
MASTER_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
CORS_ORIGINS=http://localhost:5173
ALLOW_LAN_ORIGINS=0
ENFORCE_STARTUP_VALIDATION=1
ENABLE_SECURITY_HEADERS=1
ENABLE_HSTS=0
PERMISSIONS_POLICY_CAMERA=none
TRUST_PROXY_IP_HEADERS=0

# Optional operator-managed AI provider credentials. Leave blank for BYOK use.
ENTERPRISE_OPENAI_API_KEY=
ENTERPRISE_ANTHROPIC_API_KEY=
ENTERPRISE_GEMINI_API_KEY=
ENTERPRISE_OLLAMA_API_KEY=
